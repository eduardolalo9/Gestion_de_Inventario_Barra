    "test:d": "firebase emulators:exec --only firestore --project demo-barinventory \"node pruebas/prueba-d-integracion.js\"",
    "test:f3": "firebase emulators:exec --only firestore --project demo-barinventory \"node pruebas/prueba-f3-integracion.js\"",
    "test:f3nav": "node pruebas/prueba-f3-navegador.js",
