rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() { return request.auth != null; }
    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }
    function esPropioUid(uid) { return estaAutenticado() && request.auth.uid == uid; }
    function rolSinCambio() {
      return !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /usuarios/{uid} {
      allow read:   if esPropioUid(uid) || esAdmin();
      allow create: if esPropioUid(uid) && request.resource.data.role == 'user';
      allow update: if esAdmin() || (esPropioUid(uid) && rolSinCambio());
      allow delete: if esAdmin();
    }

    match /inventarioApp/{docId} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado();
      allow update: if estaAutenticado();
      allow delete: if esAdmin();

      match /ordersChunks/{chunkId}      { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }
      match /inventoriesChunks/{chunkId} { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }
      match /stockAreas/{area}           { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }
      match /conteoMultiUsuario/{id}     { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }

      match /conteoAreas/{area} {
        allow read: if estaAutenticado();
        allow write: if estaAutenticado();
        match /dispositivos/{devId} {
          allow read: if estaAutenticado();
          allow write: if estaAutenticado();
        }
      }

      match /userAuditoria/{uid} {
        allow read:   if estaAutenticado();
        allow create: if esPropioUid(uid) || esAdmin();
        allow update: if esPropioUid(uid) || esAdmin();
        allow delete: if esPropioUid(uid) || esAdmin();
      }

      match /conflictos/{id} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if false;
        allow delete: if esAdmin();
      }
      match /cambios/{id} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if false;
        allow delete: if esAdmin();
      }
    }

    match /catalogo/{docId} {
      allow read:  if estaAutenticado();
      allow write: if esAdmin();
    }
    match /ajustes/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.estado == 'pendiente';
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    match /notificaciones/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado();
      allow update: if estaAutenticado();
      allow delete: if esAdmin();
    }
    match /reportes/{id} {
      allow read:  if estaAutenticado();
      allow create: if esAdmin();
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    match /historialCambios/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado();
      allow update: if false;
      allow delete: if esAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
