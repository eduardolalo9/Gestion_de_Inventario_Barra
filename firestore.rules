rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() { return request.auth != null; }
    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }
    function esPropioUid(uid) { return estaAutenticado() && request.auth.uid == uid; }
    function rolSinCambio() {
      return !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /usuarios/{uid} {
      allow read:   if esPropioUid(uid) || esAdmin();
      allow create: if esPropioUid(uid) && request.resource.data.role == 'user';
      allow update: if esAdmin() || (esPropioUid(uid) && rolSinCambio());
      allow delete: if esAdmin();
    }

    match /inventarioApp/{docId} {
      allow read:   if estaAutenticado();
      // FIX-SEC-5: validación mínima de forma. Antes cualquier usuario
      // autenticado podía escribir `products` con cualquier tipo (string,
      // número, null) y la app lo aceptaba sin objeción del servidor —
      // dependía enteramente de que _applyCloudData() en el cliente lo
      // rechazara. Ahora, si el campo `products` está presente en la
      // escritura, debe ser una lista.
      allow create: if estaAutenticado()
                    && (!('products' in request.resource.data) || request.resource.data.products is list);
      allow update: if estaAutenticado()
                    && (!('products' in request.resource.data) || request.resource.data.products is list);
      allow delete: if esAdmin();

      match /ordersChunks/{chunkId}      { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }
      match /inventoriesChunks/{chunkId} { allow read: if estaAutenticado(); allow write: if estaAutenticado(); }

      match /stockAreas/{area} {
        // FIX-SEC-3: nada en el código actual escribe ya este documento
        // plano (verificado — el conteo regular se sincroniza exclusivamente
        // vía /productos/{productId} desde la migración de concurrencia
        // segura). Se restringe su escritura a admin, reservada para el
        // script de migración puntual; la lectura se mantiene abierta para
        // que dispositivos aún no migrados sigan funcionando durante la
        // transición.
        allow read:  if estaAutenticado();
        allow write: if esAdmin();

        // MIGRACIÓN MÍNIMA — CONCURRENCIA SEGURA: un documento por producto,
        // con optimistic locking. `create` exige version==1 (primer conteo
        // de ese producto en esa área, desde cualquier dispositivo);
        // `update` exige que la versión nueva sea exactamente version_actual+1
        // — si otro dispositivo ya escribió una versión más reciente, esta
        // condición falla y Firestore RECHAZA la escritura, en vez de
        // aceptarla y sobrescribir en silencio el valor del otro usuario.
        match /productos/{productId} {
          allow read: if estaAutenticado();

          allow create: if estaAutenticado()
                        && request.resource.data.version == 1
                        && request.resource.data.enteras is number
                        && request.resource.data.enteras >= 0
                        && request.resource.data.actualizadoPor is string;

          allow update: if estaAutenticado()
                        && request.resource.data.version == resource.data.version + 1
                        && request.resource.data.enteras is number
                        && request.resource.data.enteras >= 0
                        && request.resource.data.actualizadoPor is string;

          allow delete: if esAdmin();
        }
      }

      match /conteoMultiUsuario/{id} {
        // FIX-SEC-4: sistema legacy sin vínculo verificable entre
        // pseudo-identidad de dispositivo y uid autenticado — no es posible
        // restringir por ownership real sin retirarlo (ya recomendado en
        // auditorías previas). Como mitigación mínima, se impide el borrado
        // arbitrario mientras siga en uso.
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if estaAutenticado();
        allow delete: if esAdmin();
      }

      match /conteoAreas/{area} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if estaAutenticado();
        allow delete: if esAdmin();
        match /dispositivos/{devId} {
          allow read: if estaAutenticado();
          allow create: if estaAutenticado();
          allow update: if estaAutenticado();
          allow delete: if esAdmin();
        }
      }

      match /userAuditoria/{uid} {
        // FIX-SEC-1 (CRÍTICO): antes 'read' era estaAutenticado() sin más —
        // cualquier usuario podía leer el conteo en curso de cualquier otro
        // bartender directamente vía la SDK, sin pasar por la UI que sí
        // filtra por uid propio. La auditoría "ciega" no era ciega a nivel
        // de servidor. Ahora solo el propio dueño del documento o un admin
        // pueden leerlo — igual que ya estaba correctamente resuelto para
        // create/update/delete.
        allow read: if esPropioUid(uid) || esAdmin();

        // FIX-SEC-2 (CRÍTICO): el campo `isAdmin` de este documento lo
        // escribe el propio cliente (syncMyAuditoriaToFirestore), y
        // _recalcAdminAggregatedConteo() lo usa para decidir qué conteo
        // tiene autoridad en la consolidación — sin esta condición,
        // cualquier usuario con role='user' podía escribir isAdmin:true en
        // su propio documento y hacer que su conteo sobrescribiera al del
        // admin real. Ahora, si el documento declara isAdmin:true, la
        // regla exige que quien escribe sea un admin verificado
        // server-side (contra usuarios/{uid}.role) — el campo deja de ser
        // una autodeclaración y pasa a ser, otra vez, un hecho verificado.
        allow create: if (esPropioUid(uid) || esAdmin())
                      && (request.resource.data.isAdmin != true || esAdmin());
        allow update: if (esPropioUid(uid) || esAdmin())
                      && (request.resource.data.isAdmin != true || esAdmin());
        allow delete: if esPropioUid(uid) || esAdmin();
      }

      match /conflictos/{id} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if false;
        allow delete: if esAdmin();
      }
      match /cambios/{id} {
        allow read: if estaAutenticado();
        allow create: if estaAutenticado();
        allow update: if false;
        allow delete: if esAdmin();
      }
    }

    match /catalogo/{docId} {
      allow read:  if estaAutenticado();
      allow write: if esAdmin();
    }
    match /ajustes/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.solicitanteUid == request.auth.uid
                    && request.resource.data.estado == 'pendiente';
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    match /notificaciones/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado();
      allow update: if estaAutenticado();
      allow delete: if esAdmin();
    }
    match /reportes/{id} {
      allow read:  if estaAutenticado();
      allow create: if esAdmin();
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    match /historialCambios/{id} {
      allow read:   if estaAutenticado();
      allow create: if estaAutenticado();
      allow update: if false;
      allow delete: if esAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
